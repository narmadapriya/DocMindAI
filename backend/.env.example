# DocMindAI Phase 15 deployment template.
# Keep the real backend/.env from the frozen Phase 14 baseline for your local machine.
# For a new environment, copy this file to .env and replace secrets/connection values.

PROJECT_NAME=DocMindAI
API_VERSION=v1
HOST=127.0.0.1
PORT=8000
DEBUG=false

DATABASE_URL=postgresql+psycopg://docmindai:CHANGE_ME@127.0.0.1:5432/docmindai

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

UPLOAD_DIR=uploads
CHROMA_DB_DIR=app/chroma_db

# The frozen Phase 14 reasoning agent explicitly uses qwen2.5vl:3b.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
EMBEDDING_MODEL=nomic-embed-text

# Optional runtime tuning already understood by the frozen Phase 14 code.
OLLAMA_TIMEOUT=600
OLLAMA_KEEP_ALIVE=30m
EMBEDDING_KEEP_ALIVE=30m
