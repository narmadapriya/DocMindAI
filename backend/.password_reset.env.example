# Optional DocMindAI password-recovery mail configuration.
# Copy this file to .password_reset.env and fill in real credentials.
# The real .password_reset.env is ignored by Docker and must never be committed.

DOCMINDAI_FRONTEND_URL=http://localhost:5173
DOCMINDAI_SMTP_HOST=smtp.gmail.com
DOCMINDAI_SMTP_PORT=587
DOCMINDAI_SMTP_USERNAME=your-email@gmail.com
DOCMINDAI_SMTP_PASSWORD=your-app-password
DOCMINDAI_SMTP_FROM_EMAIL=your-email@gmail.com
DOCMINDAI_SMTP_USE_TLS=true
DOCMINDAI_SMTP_USE_SSL=false
